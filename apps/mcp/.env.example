# Tee Agent MCP environment — copy to .env only for local MCP development.

# ── Network RPC ───────────────────────────────────────────────────────────────
# Set the RPC URL for the chain you want MCP tools to read from.
# Example:
#   RPC_URL_ARBITRUM_SEPOLIA=https://sepolia-rollup.arbitrum.io/rpc
RPC_URL_ARBITRUM_SEPOLIA=

# ── Metadata / private blob preparation ──────────────────────────────────────
# Required only for prepare flows that upload public metadata to IPFS or
# encrypted ERC-7857 private blobs to 0G Storage.
PINATA_JWT=
RPC_URL_ZERO_G=
INDEXER_URL_ZERO_G=

# ── HTTP transport ────────────────────────────────────────────────────────────
# Optional. stdio is the default transport.
# MCP_TRANSPORT=http
# MCP_HOST=127.0.0.1
# MCP_PORT=3001

# Optional API key for hosted HTTP MCP access. The MCP server does not hold a
# private transaction signer; write-oriented tools return calldata for the
# caller to submit with their own wallet.
MCP_API_KEY=
