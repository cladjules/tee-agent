# ── Network ────────────────────────────────────────────────────────────────────
# baseSepolia | base
NEXT_PUBLIC_NETWORK=baseSepolia
RPC_URL=https://sepolia.base.org

# ── Deployed Contracts ─────────────────────────────────────────────────────────
# Auto-fill with: npm run setup-env --prefix contracts [chainId]
AGENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_TEE_VERIFIER_ADDRESS=

# ── Deployer key (server-side only — never expose publicly) ───────────────────
PRIVATE_KEY=

# ── Oracle ────────────────────────────────────────────────────────────────────
ORACLE_PRIVATE_KEY=
# Optional override. If omitted, the dashboard derives this from ORACLE_PRIVATE_KEY.
TEE_ENCRYPTION_PUBLIC_KEY=

# Optional: URL of the Phala Cloud CVM oracle. When set, uses remote TEE for transfers.
ORACLE_URL=

# ── 0G Storage ────────────────────────────────────────────────────────────────
# Used for storing encrypted agent blobs and metadata on 0G decentralised storage.
# Falls back to PRIVATE_KEY if not set.
ZERO_G_PRIVATE_KEY=
# ZERO_G_RPC_URL=https://evmrpc-testnet.0g.ai
# ZERO_G_INDEXER_URL=https://indexer-storage-testnet-standard.0g.ai
