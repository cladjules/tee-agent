# ── Network ────────────────────────────────────────────────────────────────────
# baseSepolia | base
NEXT_PUBLIC_NETWORK=baseSepolia
RPC_URL=https://sepolia.base.org

# ── Deployed Contracts ─────────────────────────────────────────────────────────
# Auto-fill with: npm run setup-env --prefix contracts [chainId]
AGENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_TEE_VERIFIER_ADDRESS=
# First deployment block — avoids scanning from genesis (auto-set by setup-env).
AGENT_REGISTRY_FROM_BLOCK=

# ── Deployer key (server-side only — never expose publicly) ───────────────────
PRIVATE_KEY=

# ── Oracle ────────────────────────────────────────────────────────────────────
# URL of the Phala Cloud CVM oracle (or local tappd simulator).
# Used both server-side (mint, transfer) and client-side (Run Oracle / Validate forms).
# Local dev: start with `npm run dev:prediction-market --prefix apps/oracle`
#   then: npm run set-oracle:baseSepolia --prefix contracts   (fetches /address, updates params + .env)
#   then: npm run setOracle:baseSepolia --prefix contracts    (registers address on-chain)
NEXT_PUBLIC_ORACLE_URL=http://localhost:3001

# ── IPFS (Pinata) ─────────────────────────────────────────────────────────────
# Required for uploading agent metadata JSON (agentMetadataUri) to IPFS.
# Create a V3 API key at https://app.pinata.cloud/developers/api-keys with the
# org:files:write scope (V3 / Files API).
PINATA_JWT=

# ── 0G Storage ────────────────────────────────────────────────────────────────
# Used for storing encrypted agent blobs (ERC-7857 intelligent data).
ZERO_G_RPC_URL=https://evmrpc-testnet.0g.ai
# Turbo is the recommended indexer; standard is currently unavailable on testnet.
ZERO_G_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

