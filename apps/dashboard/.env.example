# ── Network ────────────────────────────────────────────────────────────────────
# Per-network server RPC URLs (both can be set simultaneously for multi-chain support).
# These are used by Server Actions, indexing, and cron workers only. Browser
# wallet reads/estimates/writes use the connected wallet provider RPC.
# Do not add NEXT_PUBLIC_RPC_URL_*.
# Example values:
#   RPC_URL_ARBITRUM_SEPOLIA=https://sepolia-rollup.arbitrum.io/rpc
PORT=
RPC_URL_ARBITRUM_SEPOLIA=

# ── Deployed Contracts ─────────────────────────────────────────────────────────
# Public contract addresses and AgentRegistry scan start blocks live in:
#   deployments.json
# Auto-fill with:
#   npm run setup-env --prefix contracts
# Missing deployed contract addresses fail fast; there are no runtime defaults.

# ── Server signer (server-side only — never expose publicly) ──────────────────
# Used by dashboard backend work such as uploads/validation automation.
# Browser mint/run/transfer transactions use the connected wallet, not this key.
# For automatic validation this address must own the ERC-8004 agent id and must
# match the oracle PRIVATE_KEY address expected by POST /validate.
PRIVATE_KEY=

# ── Automatic validation worker ───────────────────────────────────────────────
# Comma-separated teeOracle service URLs this dashboard worker owns.
# The worker only calls /validate for ValidationRequest events whose agent
# metadata resolves to one of these URLs.
VALIDATION_ORACLE_URLS=http://localhost:3001

# ── WalletConnect ─────────────────────────────────────────────────────────────
# Required for WalletConnect support. Create a project at https://cloud.walletconnect.com.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── IPFS (Pinata) ─────────────────────────────────────────────────────────────
# Required for uploading agent metadata JSON (agentMetadataUri) to IPFS.
# Create a V3 API key at https://app.pinata.cloud/developers/api-keys with the
# org:files:write scope (V3 / Files API).
PINATA_JWT=

# ── 0G Storage ────────────────────────────────────────────────────────────────
# Used exclusively for ERC-7857 encrypted intelligent data blobs (zerog:// URIs).
# Example values:
#   RPC_URL_ZERO_G=https://evmrpc-testnet.0g.ai
#   INDEXER_URL_ZERO_G=https://indexer-storage-testnet-turbo.0g.ai
RPC_URL_ZERO_G=
INDEXER_URL_ZERO_G=

# ── Agent Index Cache (Upstash Redis) ─────────────────────────────────────────
# Optional but recommended: caches indexed agents and last-seen block so the
# dashboard doesn't rescan logs from genesis on every page load.
# Create a free Redis database at https://console.upstash.com and copy the
# REST URL + token from the database details page.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Secret token Vercel injects into cron requests (Authorization: Bearer ...).
# Set this in your Vercel project settings under Environment Variables.
CRON_SECRET=
