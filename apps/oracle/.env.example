# Oracle environment — copy to .env and fill in values.
# Deploy: npm run deploy -- src/examples/prediction-market.ts  (from apps/oracle/)
# Or from repo root: npm run deploy:oracle -- src/examples/prediction-market.ts
# Dev:    npm run dev:prediction-market      or  npm run dev:web-fetcher
# Env vars are encrypted inside the TDX CVM; never stored in plain text.
# ORACLE_ENTRY is set by scripts/deploy-cvm.mjs; do not put it in .env.

# ─── Network ──────────────────────────────────────────────────────────────────
NETWORK=
# base | baseSepolia
# Example values:
#   RPC_URL_BASE=https://mainnet.base.org
#   RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
RPC_URL_BASE=
RPC_URL_BASE_SEPOLIA=

# ─── Contracts ────────────────────────────────────────────────────────────────
# Public contract addresses live in the repository root deployments.json.
# Oracle entrypoints import that file and pass it to startOracle().
# Missing deployed contract addresses fail fast; there are no runtime defaults.

# ─── Signing / fees ───────────────────────────────────────────────────────────
# Used to submit initValidator on startup, validation responses, and 0G upload fees.
# Required for Base Sepolia dev and real Phala deployments.
PRIVATE_KEY=

# ─── LLM (Red Pill / OpenAI-compatible) ──────────────────────────────────────
# Required by prediction-market, web-fetcher, and the /validate scorer.
# API keys are NOT stored in on-chain agent blobs — they live here in the TEE.
# Red Pill example:
#   LLM_API_BASE=https://api.red-pill.ai/v1
#   LLM_VALIDATION_MODEL=phala/gemma-4-26b-a4b-uncensored
LLM_API_KEY=
LLM_API_BASE=
LLM_VALIDATION_MODEL=

# ─── 0G Storage ───────────────────────────────────────────────────────────────
# Example values:
#   ZERO_G_RPC_URL=https://evmrpc-testnet.0g.ai
#   ZERO_G_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
ZERO_G_RPC_URL=
ZERO_G_INDEXER_URL=

# ─── Server / verifier ────────────────────────────────────────────────────────
PORT=
DSTACK_VERIFIER_URL=
# Local dev only. Omit in a real Phala CVM.
# Requires TeeVerifier deployed with MockDcapAttestation.
DSTACK_SIMULATOR_ENDPOINT=
