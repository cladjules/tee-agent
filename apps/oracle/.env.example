# Oracle environment — copy to .env and fill in values.
# Deploy: npm run deploy:prediction-market  or  npm run deploy:web-fetcher  (from apps/oracle/)
# Dev:    npm run dev:prediction-market      or  npm run dev:web-fetcher
# Env vars are encrypted inside the TDX CVM; never stored in plain text.

# ─── Network ──────────────────────────────────────────────────────────────────
NETWORK=baseSepolia                          # base | baseSepolia
RPC_URL_BASE=https://mainnet.base.org
RPC_URL_BASE_SEPOLIA=https://sepolia.base.org

# ─── Contracts ────────────────────────────────────────────────────────────────
# Public contract addresses live in the repository root deployments.json.
# Oracle entrypoints import that file and pass it to startOracle().
# TEE_VERIFIER_ADDRESS=                    # Optional override; otherwise deployments.json is used

# ─── Signing / fees ───────────────────────────────────────────────────────────
# Used to submit initValidator on startup, validation responses, and 0G upload fees.
# Required on real Phala deployments. Local simulator mode skips initValidator.
PRIVATE_KEY=

# ─── LLM (Red Pill / OpenAI-compatible) ──────────────────────────────────────
# Required by prediction-market, web-fetcher, and the /validate scorer.
# API keys are NOT stored in on-chain agent blobs — they live here in the TEE.
LLM_API_KEY=                                 # https://red-pill.ai for Phala TEE-attested models
LLM_API_BASE=https://api.red-pill.ai/v1      # Override to use a different OpenAI-compatible provider
LLM_VALIDATION_MODEL=phala/gemma-4-26b-a4b-uncensored  # Model used by /validate scorer

# ─── 0G Storage ───────────────────────────────────────────────────────────────
ZERO_G_RPC_URL=https://evmrpc-testnet.0g.ai
ZERO_G_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# ─── Optional overrides ───────────────────────────────────────────────────────
PORT=3001
# IDENTITY_REGISTRY_ADDRESS=               # Overrides the default ERC-8004 Identity Registry
# DSTACK_VERIFIER_URL=http://localhost:8080 # dstack-verifier sidecar (default: http://verifier:8080)
# DSTACK_SIMULATOR_ENDPOINT=http://localhost:8090  # Set to use local tappd simulator in dev
