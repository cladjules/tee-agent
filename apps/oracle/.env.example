# Oracle environment — copy to .env and fill in values.
# Deploy from repo root:
#   npm run oracle:image
#   npm run oracle:deploy -- src/examples/prediction-market.ts
# Dev:    npm run dev:prediction-market      or  npm run dev:web-fetcher
# Env vars are encrypted inside the TDX CVM; never stored in plain text.
# ORACLE_ENTRY is set by root scripts/deploy-cvm.mjs; do not put it in .env.

# ─── Network ──────────────────────────────────────────────────────────────────
NETWORK=
# local | arbitrumSepolia | baseSepolia | base
# Example values:
#   RPC_URL_BASE=https://mainnet.base.org
#   RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
#   RPC_URL_ARBITRUM_SEPOLIA=https://sepolia-rollup.arbitrum.io/rpc
RPC_URL_BASE=
RPC_URL_BASE_SEPOLIA=
RPC_URL_ARBITRUM_SEPOLIA=

# ─── Signing / fees ───────────────────────────────────────────────────────────
# Oracle transaction signer. This is NOT the agent owner/creator key.
# It only pays gas for oracle-owned infrastructure transactions:
# initValidator on startup, validation responses, and 0G upload fees.
# Agent owners sign mint/run/transfer and ReencryptRequest messages with their
# own wallet; those signatures are sent to the oracle request body.
# The bundled /validate endpoint only accepts EIP-712 requests signed by this
# address. For dashboard automatic validation, set the dashboard PRIVATE_KEY to
# the same address.
# Required for Base Sepolia dev and real Phala deployments.
PRIVATE_KEY=

# ─── LLM (Red Pill / OpenAI-compatible) ──────────────────────────────────────
# Required by prediction-market and the /validate scorer.
# API keys are NOT stored in on-chain agent blobs — they live here in the TEE.
# Red Pill example:
#   LLM_API_BASE=https://api.red-pill.ai/v1
#   LLM_VALIDATION_MODEL=google/gemma-4-31b-it
LLM_API_KEY=
LLM_API_BASE=
LLM_VALIDATION_MODEL=
TAVILY_API_KEY=

# ─── 0G Storage ───────────────────────────────────────────────────────────────
# Example values:
#   RPC_URL_ZERO_G=https://evmrpc-testnet.0g.ai
#   INDEXER_URL_ZERO_G=https://indexer-storage-testnet-turbo.0g.ai
RPC_URL_ZERO_G=
INDEXER_URL_ZERO_G=

# ─── Verifier ─────────────────────────────────────────────────────────────────
# Phala compose also sets PORT=3001 for production.
PORT=3001
DSTACK_VERIFIER_URL=
