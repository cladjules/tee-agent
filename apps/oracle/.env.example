# Oracle environment — copy to .env and fill in values.
# Deploy: npm run deploy:prediction-market  or  npm run deploy:web-fetcher  (from apps/oracle/)
# Dev:    npm run dev:prediction-market      or  npm run dev:web-fetcher
# Env vars are encrypted inside the TDX CVM; never stored in plain text.

# ─── Required ────────────────────────────────────────────────────────────────
RPC_URL=https://sepolia.base.org
AGENT_REGISTRY_ADDRESS=            # Deployed AgentRegistry contract address

# ─── 0G Storage ──────────────────────────────────────────────────────────────
ZERO_G_PRIVATE_KEY=                # Pays 0G Storage upload fees during re-encryption (falls back to TEE wallet key — fund that address instead if unset)

# ─── LLM (Red Pill / OpenAI-compatible) ─────────────────────────────────────
# Required by prediction-market and web-fetcher handlers.
# API keys are NOT stored in on-chain agent blobs — they live here in the TEE.
LLM_API_KEY=                       # API key (https://red-pill.ai for Phala TEE-attested models)
LLM_API_BASE=https://api.red-pill.ai/v1  # Provider base URL (default: Phala Red Pill)

# ─── Optional ────────────────────────────────────────────────────────────────
ZERO_G_RPC_URL=https://evmrpc-testnet.0g.ai
ZERO_G_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
