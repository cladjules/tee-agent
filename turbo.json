{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "@tee-agent/contracts#build": {
      "dependsOn": [],
      "outputs": ["artifacts/**", "../../packages/agent/src/abis.ts"]
    },
    "@tee-agent/agent#build": {
      "dependsOn": ["@tee-agent/contracts#build", "^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@tee-agent/oracle#dev": {
      "dependsOn": ["@tee-agent/server#build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
