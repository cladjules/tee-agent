{
  "name": "@tee-agent/agent",
  "version": "0.1.0",
  "type": "module",
  "description": "Tee Agent Packages: Core libraries and utilities for building and running TEE-based agents, including ERC-7857 AgentNFT interactions, TDX re-encryption, and secure off-chain computation",
  "exports": {
    "./types": "./dist/types.js",
    "./network": "./dist/network.js",
    "./crypto": "./dist/crypto.js",
    "./abis": "./dist/abis.js",
    "./registry": "./dist/registry/index.js",
    "./storage/zero-g": "./dist/storage/zero-g.js",
    "./ops/metadata": "./dist/ops/metadata.js",
    "./ops/mint": "./dist/ops/mint.js",
    "./ops/transfer": "./dist/ops/transfer.js",
    "./ops/transfer-acceptance": "./dist/ops/transfer-acceptance.js",
    "./ops/services": "./dist/ops/services.js",
    "./ops/feedback": "./dist/ops/feedback.js",
    "./ops/validate": "./dist/ops/validate.js",
    "./typed-data": "./dist/typed-data.js"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "clean": "rm -rf dist .turbo tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.10",
    "eciesjs": "^0.5.0",
    "ethers": "6.13.1",
    "viem": "^2.52.2"
  },
  "license": "Apache-2.0"
}
