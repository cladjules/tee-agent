{
  "name": "@tee-agent/agent",
  "version": "0.1.0",
  "type": "module",
  "description": "ERC-7857 AI Agent NFTs with private encrypted metadata",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/core/types.d.ts",
      "import": "./dist/core/types.js"
    },
    "./config": {
      "types": "./dist/core/config.d.ts",
      "import": "./dist/core/config.js"
    },
    "./encryption": {
      "types": "./dist/crypto/index.d.ts",
      "import": "./dist/crypto/index.js"
    },
    "./abis": {
      "types": "./dist/abis.d.ts",
      "import": "./dist/abis.js"
    },
    "./ipfs": {
      "types": "./dist/storage/ipfs.d.ts",
      "import": "./dist/storage/ipfs.js"
    },
    "./registry": {
      "types": "./dist/core/registry.d.ts",
      "import": "./dist/core/registry.js"
    },
    "./zero-g": {
      "types": "./dist/storage/zero-g.d.ts",
      "import": "./dist/storage/zero-g.js"
    },
    "./mint": {
      "types": "./dist/ops/mint.d.ts",
      "import": "./dist/ops/mint.js"
    },
    "./transfer": {
      "types": "./dist/ops/transfer.d.ts",
      "import": "./dist/ops/transfer.js"
    },
    "./agent-services": {
      "types": "./dist/ops/agent-services.d.ts",
      "import": "./dist/ops/agent-services.js"
    },
    "./oracle": {
      "types": "./dist/ops/oracle.d.ts",
      "import": "./dist/ops/oracle.js"
    },
    "./resolve": {
      "types": "./dist/ops/resolve.d.ts",
      "import": "./dist/ops/resolve.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@0gfoundation/0g-ts-sdk": "^1.2.8",
    "eciesjs": "^0.5.0",
    "ethers": "6.16.0",
    "viem": "^2.49.3"
  }
}
