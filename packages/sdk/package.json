{
  "name": "@tee-agent/sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Convenience wrapper for @tee-agent/agent — bound SDK factory for standalone consumers",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "clean": "rm -rf dist .turbo",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@tee-agent/agent": "*",
    "viem": "^2.49.3"
  }
}
