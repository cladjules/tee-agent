# Script-managed local state.
# `npm run oracle:image` prompts when needed and writes these values.
GHCR_PUSH_PAT=
ORACLE_IMAGE=
ORACLE_DEPLOYMENTS_SHA=
ORACLE_IMAGE_SOURCE_SHA=
DSTACK_DOCKER_USERNAME=
DSTACK_DOCKER_PASSWORD=
DSTACK_DOCKER_REGISTRY=ghcr.io

# Oracle dstack key path. Changing this rotates the TEE signing address.
APP_NAME=TEE-ORACLE
