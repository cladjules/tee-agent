{
  "name": "tee-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "description": "Web3-Aware AI Agent SDK — giving any AI agent framework full Web3 awareness",
  "workspaces": [
    "packages/agent",
    "packages/server",
    "apps/dashboard",
    "apps/oracle",
    "contracts"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "DEBUG=true turbo run dev",
    "test": "tsx --tsconfig tsconfig.test.json --test __tests__/**/*.test.ts",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,sol,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,sol,json,md}\"",
    "e2e:local": "node --import tsx __tests__/e2e.ts local",
    "e2e:baseSepolia": "node --import tsx __tests__/e2e.ts baseSepolia",
    "deploy:oracle": "npm run deploy --workspace=apps/oracle --",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@turbo/gen": "^2.9.7",
    "dotenv": "^17.4.2",
    "prettier": "^3.8.3",
    "prettier-plugin-solidity": "^2.3.1",
    "tsx": "^4.19.4",
    "turbo": "^2.9.7"
  },
  "overrides": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "viem": "^2.49.3"
  },
  "engines": {
    "node": ">=20"
  }
}
