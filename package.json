{
  "name": "tee-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "description": "Web3-Aware AI Agent SDK — giving any AI agent framework full Web3 awareness",
  "workspaces": [
    "packages/agent",
    "packages/oracle",
    "apps/dashboard",
    "apps/mcp",
    "apps/oracle",
    "contracts"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "DEBUG=true turbo run dev",
    "test": "tsx --tsconfig tsconfig.test.json --test __tests__/**/*.test.ts",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,sol,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,sol,json,md}\"",
    "e2e:local": "node --import tsx __tests__/e2e.ts local",
    "e2e:arbitrumSepolia": "node --import tsx __tests__/e2e.ts arbitrumSepolia",
    "mcp:build": "npm run build --workspace @tee-agent/mcp",
    "mcp:dev": "npm run dev --workspace @tee-agent/mcp",
    "mcp:http": "MCP_TRANSPORT=http npm run dev --workspace @tee-agent/mcp",
    "mcp:start": "node apps/mcp/dist/index.js",
    "mcp:start:http": "MCP_TRANSPORT=http node apps/mcp/dist/index.js",
    "oracle:image": "node scripts/push-oracle-image.mjs",
    "oracle:deploy": "node scripts/deploy-cvm.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@turbo/gen": "^2.9.18",
    "prettier": "^3.8.4",
    "prettier-plugin-solidity": "^2.3.1",
    "tsx": "^4.22.4",
    "turbo": "^2.9.18"
  },
  "overrides": {
    "open-jsonrpc-provider": {
      "axios": "1.16.0"
    },
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "viem": "^2.49.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
