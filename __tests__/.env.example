# ── E2E signer ────────────────────────────────────────────────────────────────
# Pays gas for minting, transfer, validation, feedback, and 0G uploads.
PRIVATE_KEY=

# ── E2E RPC ───────────────────────────────────────────────────────────────────
# Example values:
#   LOCAL_RPC_URL=http://127.0.0.1:8545
#   RPC_URL_ARBITRUM_SEPOLIA=https://sepolia-rollup.arbitrum.io/rpc
LOCAL_RPC_URL=
RPC_URL_ARBITRUM_SEPOLIA=

# ── Running oracle ────────────────────────────────────────────────────────────
# E2E starts a localhost oracle on http://localhost:3001.
# ORACLE_URL is intentionally ignored.

# ── Storage used by SDK mint/update paths ─────────────────────────────────────
# E2E uses real SDK storage: IPFS metadata + 0G encrypted blobs.
PINATA_JWT=
RPC_URL_ZERO_G=
INDEXER_URL_ZERO_G=
