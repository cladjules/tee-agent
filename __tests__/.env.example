# ── E2E signer ────────────────────────────────────────────────────────────────
# Pays gas for minting, transfer, validation, feedback, and 0G uploads.
PRIVATE_KEY=

# ── E2E RPC ───────────────────────────────────────────────────────────────────
# Example values:
#   LOCAL_RPC_URL=http://127.0.0.1:8545
#   RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
LOCAL_RPC_URL=
RPC_URL_BASE_SEPOLIA=

# ── Running oracle ────────────────────────────────────────────────────────────
# Must point at the oracle service used by minted agents.
ORACLE_URL=

# ── Storage used by SDK mint/update paths ─────────────────────────────────────
# E2E uses real SDK storage: IPFS metadata + 0G encrypted blobs.
PINATA_JWT=
RPC_URL_ZERO_G=
INDEXER_URL_ZERO_G=
